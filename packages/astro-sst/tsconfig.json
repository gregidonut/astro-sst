{
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "strict": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "NodeNext",
    "outDir": "./dist",
    "target": "ES2022"
  }
}
